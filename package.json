{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "vite build && tsx scripts/prerender-pages.tsx",
    "preview": "node scripts/dev-local.mjs --preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:php && tsx --test scripts/test-equipment-template.ts scripts/test-platforms-page.ts scripts/test-applications-page.ts scripts/test-client-visuals.ts scripts/test-static-pages.ts scripts/test-tag-manager.ts scripts/test-final-corrections.ts",
    "test:php": "php php/tests/inquiries-test.php",
    "package:locaweb": "npm run build && node scripts/package-locaweb.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
