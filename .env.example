VITE_API_URL="http://localhost:3333"
# Set to production only in the public production deployment, not in previews.
VITE_SITE_ENV="preview"
# Locaweb SMTP, server-only. Never prefix credentials with VITE_.
# Set USER and PASS together to enable SMTP instead of the optional webhook.
INQUIRIES_SMTP_HOST="email-ssl.com.br"
INQUIRIES_SMTP_PORT="465"
INQUIRIES_SMTP_USER=""
INQUIRIES_SMTP_PASS=""
# Optional alternative email service. Receives email.to/subject/text/replyTo and attachment.
# Return {"ok":true,"emailSent":true,"recipient":"comercial@accesslift.com.br"} only after sending.
INQUIRIES_WEBHOOK_URL=""
INQUIRIES_WEBHOOK_TOKEN=""
# GTM-5MH55G4K is installed globally in index.html.
# Direct tags are ignored while GTM is enabled to prevent duplicate tracking.
VITE_GA4_ID=""
VITE_GOOGLE_ADS_ID=""
